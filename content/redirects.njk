---
# Builds a small forwarding page at every old address listed under redirectFrom in a page's
# front matter, so links to pages that have moved keep working.
pagination:
  data: collections.redirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}"
layout: false
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <title>Page moved · {{ site.title }}</title>
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ redirect.to }}">
  <meta http-equiv="refresh" content="0; url={{ redirect.to }}">
</head>
<body>
  <p>This page has moved to <a href="{{ redirect.to }}">{{ redirect.to }}</a>.</p>
</body>
</html>
