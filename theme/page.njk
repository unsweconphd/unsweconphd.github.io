---
layout: base.njk
---
{%- if eleventyNavigation and eleventyNavigation.parent %}
<p class="eyebrow">
  {%- for crumb in collections.all | eleventyNavigationBreadcrumb(eleventyNavigation.key) %}<a href="{{ crumb.url }}">{{ crumb.title }}</a>{% endfor -%}
</p>
{%- endif %}
<h1>{{ title }}</h1>
{%- if reviewed %}
<p class="reviewed">Last reviewed {{ reviewed | readableDate }}</p>
{%- endif %}
{%- set headings = content | pageHeadings %}
{%- if toc and headings.length > 1 %}
<nav class="on-this-page" aria-labelledby="on-this-page-label">
  <p id="on-this-page-label">On this page</p>
  <ul>
    {%- for heading in headings %}
    <li><a href="#{{ heading.id }}">{{ heading.text | safe }}</a></li>
    {%- endfor %}
  </ul>
</nav>
{%- endif %}
{{ content | safe }}
