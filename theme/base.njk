<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url == "/" %}{{ site.title }} · {{ site.institution }}{% else %}{{ title }} · {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ site.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="layout">
    <header class="sidebar">
      <div class="sidebar-inner">
        <a class="site-title" href="/">{{ site.title }}<span>{{ site.institution }}</span></a>
        <details class="toc" id="toc" open>
          <summary>Contents</summary>
          <nav aria-label="Handbook contents">
            <ul>
              {%- for section in collections.all | eleventyNavigation %}
              <li>
                <a href="{{ section.url }}"{% if section.url == page.url %} aria-current="page"{% endif %}>{{ section.title }}</a>
                {%- if section.children.length %}
                <ul>
                  {%- for entry in section.children %}
                  <li><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
                  {%- endfor %}
                </ul>
                {%- endif %}
              </li>
              {%- endfor %}
            </ul>
          </nav>
        </details>
        <script>
          // On narrow screens the menu starts folded. Without JavaScript it simply stays open.
          (function () {
            var toc = document.getElementById("toc");
            var narrow = window.matchMedia("(max-width: 56rem)");
            function sync() { toc.open = !narrow.matches; }
            sync();
            narrow.addEventListener("change", sync);
          })();
        </script>
      </div>
    </header>
    <main id="main">
      <div class="content">
        {{ content | safe }}
        <footer class="site-footer">
          {{ site.title }} · {{ site.institution }} · <a href="{{ site.repository }}/edit/main/{{ page.inputPath | replace('./', '') }}">Edit this page on GitHub</a>
        </footer>
      </div>
    </main>
  </div>
</body>
</html>
